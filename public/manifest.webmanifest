{
  "id": "/app",
  "name": "Commonveil",
  "short_name": "Commonveil",
  "description": "End-to-end encrypted messages and communities.",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf8f5",
  "theme_color": "#0f5a4e",
  "categories": ["social", "communication"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Messages", "url": "/app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Discover servers", "url": "/app/discover", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Settings", "url": "/app/settings", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
