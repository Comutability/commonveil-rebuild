// The key that signs Commonveil sign-in's access tokens. Made once. Backend only.
{
  "name": "CvSecret",
  "type": "object",
  "description": "The key that signs Commonveil sign-in's access tokens. Made once. Backend only.",
  "properties": {
    "name": {
      "type": "string"
    },
    "value": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "value"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
