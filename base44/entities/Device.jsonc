{
  "name": "Device",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string",
      "description": "Random id chosen by the device."
    },
    "label": {
      "type": "string"
    },
    "sign_pub": {
      "type": "string",
      "description": "Device ECDSA public key. Its private key never leaves the device."
    },
    "box_pub": {
      "type": "string",
      "description": "Device ECDH public key used to deliver the keyring to it."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "revoked"
      ],
      "default": "pending"
    },
    "cert_key_version": {
      "type": "number"
    },
    "cert_issued_at": {
      "type": "string"
    },
    "cert_signature": {
      "type": "string",
      "description": "Account key signature over this device's keys."
    },
    "approved_by_device_id": {
      "type": "string"
    },
    "approved_via": {
      "type": "string",
      "enum": [
        "first_device",
        "device_approval",
        "recovery_phrase",
        "account_reset"
      ]
    },
    "approved_at": {
      "type": "string"
    },
    "pending_expires_at": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string"
    },
    "revoked_reason": {
      "type": "string",
      "enum": [
        "removed",
        "denied",
        "expired",
        "account_reset"
      ]
    },
    "synced_key_version": {
      "type": "number",
      "description": "Latest keyring version this device has confirmed it holds."
    },
    "last_seen_at": {
      "type": "string"
    },
    "kem_pub": {
      "type": "string",
      "description": "Device post-quantum hybrid public key, used to deliver the keyring to it."
    },
    "kem_sig": {
      "type": "string",
      "description": "The device's own signature over kem_pub, for devices that added one after setup."
    },
    "cert_has_kem": {
      "type": "boolean",
      "description": "Whether the certificate covers kem_pub (device-cert/v2)."
    }
  },
  "required": [
    "user_id",
    "device_id",
    "sign_pub",
    "box_pub",
    "status"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": false,
    "update": false,
    "delete": false
  }
}