{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "dm",
        "group"
      ]
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dm_key": {
      "type": "string",
      "description": "Sorted pair of user ids, so a pair has one DM."
    },
    "creator_id": {
      "type": "string",
      "description": "User id of whoever started it. Not created_by: Base44 reserves that name, and queries on it never match."
    },
    "title_envelope": {
      "type": "string",
      "description": "Encrypted group name."
    },
    "title_item_id": {
      "type": "string"
    },
    "title_sender_id": {
      "type": "string"
    },
    "title_device_id": {
      "type": "string"
    },
    "title_sent_at": {
      "type": "string"
    },
    "title_signature": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string"
    },
    "admin_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Group admins. Only they can add or remove people, rename the group, set its timer and choose other admins."
    },
    "expire_seconds": {
      "type": "number",
      "description": "Disappearing messages: how long each message is kept, in seconds. 0 or missing: off."
    },
    "expiry_set_by": {
      "type": "string",
      "description": "Who last changed the timer, so members can see it."
    },
    "expiry_set_at": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "member_ids",
    "creator_id"
  ],
  "rls": {
    "read": {
      "data.member_ids": "{{user.id}}"
    },
    "create": false,
    "update": false,
    "delete": false
  }
}