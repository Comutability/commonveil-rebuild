{
  "name": "Profile",
  "type": "object",
  "properties": {
    "remote": {
      "type": "boolean",
      "description": "True for someone from another site: this row is what their own site shares about them."
    },
    "home": {
      "type": "string",
      "description": "For someone from another site: the site they belong to."
    },
    "user_id": {
      "type": "string",
      "description": "Base44 user id of the owner."
    },
    "username": {
      "type": "string",
      "description": "Handle as the member typed it. 3-20 of a-z, 0-9, underscore."
    },
    "username_key": {
      "type": "string",
      "description": "Lower-cased username, used for uniqueness."
    },
    "display_name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "delete_after_days": {
      "type": "number",
      "description": "Opt-in: delete the account after this many days without use. 0 or missing: off."
    },
    "last_active_at": {
      "type": "string",
      "description": "Kept only while delete_after_days is on, to the day."
    },
    "inactive_warned_at": {
      "type": "string",
      "description": "When the member was emailed that the account will be deleted soon."
    },
    "pronouns": {
      "type": "string"
    },
    "accent_color": {
      "type": "string",
      "description": "Profile colour, one of the app's palette."
    },
    "avatar_emoji": {
      "type": "string",
      "description": "An emoji shown instead of initials."
    },
    "avatar_image": {
      "type": "string",
      "description": "A small profile picture (data: URL, WebP/PNG/JPEG, at most 160x160), made on the person's device and kept inline: showing it fetches nothing."
    },
    "profile_visibility": {
      "type": "string",
      "description": "Who sees display name, pronouns and bio: shared (anyone you share a server or conversation with), conversations (only people you have a conversation with), nobody.",
      "enum": [
        "shared",
        "conversations",
        "nobody"
      ]
    },
    "dm_policy": {
      "type": "string",
      "description": "Who can start a conversation with you: anyone who knows your username, only people you share a server with, or nobody new.",
      "enum": [
        "anyone",
        "servers",
        "nobody"
      ]
    },
    "default_listed": {
      "type": "boolean",
      "description": "Shown in member lists of servers you join, unless changed per server. Off unless chosen."
    },
    "default_server_done": {
      "type": "boolean",
      "description": "The member has been added to the community server once (and may have left it)."
    },
    "scheduled_waiting": {
      "type": "number",
      "description": "How many of this member's messages are waiting to be sent (send later, check-ins). Only they can read it; set only by the backend."
    }
  },
  "required": [
    "user_id",
    "username",
    "username_key"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": false,
    "update": false,
    "delete": false
  }
}