{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string"
    },
    "reported_user_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "harassment",
        "impersonation",
        "illegal",
        "under_16",
        "other"
      ]
    },
    "details": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewing",
        "resolved",
        "dismissed"
      ],
      "default": "open"
    },
    "resolution_note": {
      "type": "string"
    },
    "handled_by": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "\"member\" (someone reporting directly) or \"server\" (a server's moderators escalating)."
    },
    "server_id": {
      "type": "string"
    },
    "server_report_id": {
      "type": "string"
    },
    "escalated_by": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "server_name": {
      "type": "string",
      "description": "The server's name, as the escalating moderator gave it."
    }
  },
  "required": [
    "reporter_id",
    "reported_user_id",
    "reason",
    "status"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
