{
  "name": "AccountKey",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "version": {
      "type": "number"
    },
    "ecdh_pub": {
      "type": "string",
      "description": "P-256 public key, raw 65 bytes, base64."
    },
    "sign_pub": {
      "type": "string",
      "description": "P-256 ECDSA public key, raw 65 bytes, base64."
    },
    "recovery_pub": {
      "type": "string",
      "description": "Recovery public key derived from the member's phrase."
    },
    "signed_by_version": {
      "type": "number"
    },
    "issued_at": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "recovery_mac": {
      "type": "string",
      "description": "HMAC under a key only the recovery phrase produces, on statements made with the phrase to hand. Lets a recovering device trust these keys."
    },
    "is_reset": {
      "type": "boolean",
      "default": false
    },
    "kem_pub": {
      "type": "string",
      "description": "Post-quantum hybrid public key (ML-KEM-768 + P-256), 1249 bytes, base64. Empty on statements from before November 2026."
    },
    "recovery_kem_pub": {
      "type": "string",
      "description": "Post-quantum key derived from the recovery phrase, if the account has one."
    }
  },
  "required": [
    "user_id",
    "version",
    "ecdh_pub",
    "sign_pub",
    "recovery_pub",
    "signed_by_version",
    "issued_at",
    "signature"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": false,
    "update": false,
    "delete": false
  }
}