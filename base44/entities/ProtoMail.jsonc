// A sealed protocol envelope waiting for one device to collect it (experimental). The server can't read it. Deleted when collected, or after 30 days. Backend only.
{
  "name": "ProtoMail",
  "type": "object",
  "description": "A sealed protocol envelope waiting for one device to collect it (experimental). The server can't read it. Deleted when collected, or after 30 days. Backend only.",
  "properties": {
    "to_user_id": {
      "type": "string"
    },
    "to_device": {
      "type": "string"
    },
    "from_user_id": {
      "type": "string"
    },
    "envelope": {
      "type": "string",
      "description": "The direct envelope, as JSON: a session message only the recipient device can open."
    },
    "expires_at": {
      "type": "string"
    }
  },
  "required": [
    "to_user_id",
    "to_device",
    "from_user_id",
    "envelope",
    "expires_at"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
