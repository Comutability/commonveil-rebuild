# Copy to .env and fill in (install.sh does this for you).

# Your site's address, without https://. Point its DNS at this server.
SITE_DOMAIN=chat.example.com
# People's handles are <username>.<HANDLE_DOMAIN>, for example alice.chat.example.com.
# Point a wildcard DNS record (*.chat.example.com) at this server too. Leave empty to use SITE_DOMAIN.
HANDLE_DOMAIN=
SITE_NAME=Commonveil
# For Let's Encrypt's expiry notices.
ACME_EMAIL=you@example.com
# The site's first account is made with a one-time setup code the server prints when it starts
# (install.sh shows it; or: docker compose exec app commonveil-server setup-code). That account
# is the admin. Make others admins with: docker compose exec app commonveil-server make-admin <username>
# The Commonveil Community server's admins on your site: usernames of accounts that are already
# site admins (a username alone proves nothing), or older accounts' emails.
DEFAULT_SERVER_ADMINS=

# Optional: a forum in the community server with one post per Secure Net Improvement Proposal
# on GitHub (docs/SNIP_FORUM.md). "on" makes your server read GitHub's public API.
SNIP_FORUM=
# false: nobody can sign up (after the first, admin account). Accounts are a username and password,
# with passkeys and a recovery phrase (docs/IDENTITY.md): no email needed.
OPEN_REGISTRATION=true
# Talk to other Commonveil sites (docs/FEDERATION.md). false keeps this site to itself.
FEDERATION=true
# For stricter per-domain moderation, registration and site rules, open
# Site admin -> Site rules & safety. Policies live in the persistent data
# volume. Docker switches remain upper bounds. See docs/SITE_POLICY.md.

# Optional TURN relay for calls. Leave both blank unless you run a trusted coturn
# server configured for use-auth-secret. The shared secret is never sent to browsers.
# VOICE_TURN_URLS=turns:turn.yourdomain.example:5349?transport=tcp
# VOICE_TURN_SECRET=long-random-value-at-least-32-characters
VOICE_TURN_URLS=
VOICE_TURN_SECRET=


# NEVER enable on a production or internet-facing site. Private test instances only.\n# This flag only allows encrypted stage/report storage, not account migration or inbox cutover.
EXPERIMENTAL_TRANSFER_STAGING=false
# Additional explicit private-test-only switch. Requires staging above.
# Never enable on an internet-facing production site.
EXPERIMENTAL_RECIPIENT_CONSENT=false

# Secure Net CVP-019 independent actor delivery prototype. DISABLED by default.
# Only on a disposable, access-controlled, HTTPS test site with its own data.
# The shared site operator secret must be 32+ random URL-safe characters.
# The experimental manual trust API does not make this a standards-conformant
# relay or give it a complete actor-discovery/prekey implementation.
EXPERIMENTAL_SECURE_NET_RELAY=false
SECURE_NET_RELAY_ADMIN=


# Which release to run. The updater changes this when you update.
COMMONVEIL_VERSION=latest
# This folder's full path, and a long random secret for the updater (install.sh makes one).
COMMONVEIL_DIR=/opt/commonveil
UPDATER_TOKEN=

# Only if this site can be reached under a path and nowhere else (rare): its protocol endpoints
# move under this prefix. Leave empty otherwise.
# FEDERATION_PATH_PREFIX=
