# Copy to .env and fill in (install.sh does this for you).

# Your site's address, without https://. Point its DNS at this server.
SITE_DOMAIN=chat.example.com
# People's handles are <username>.<HANDLE_DOMAIN>, for example alice.chat.example.com.
# Point a wildcard DNS record (*.chat.example.com) at this server too. Leave empty to use SITE_DOMAIN.
HANDLE_DOMAIN=
SITE_NAME=Commonveil
# For Let's Encrypt's expiry notices.
ACME_EMAIL=you@example.com
# The site's first account is made with a one-time setup code the server prints when it starts
# (install.sh shows it; or: docker compose exec app node server/index.mjs setup-code). That account
# is the admin. Make others admins with: docker compose exec app node server/index.mjs make-admin <username>
# The Commonveil Community server's admins on your site: usernames of accounts that are already
# site admins (a username alone proves nothing), or older accounts' emails.
DEFAULT_SERVER_ADMINS=
# false: nobody can sign up (after the first, admin account). Accounts are a username and password,
# with passkeys and a recovery phrase (docs/IDENTITY.md): no email needed.
OPEN_REGISTRATION=true
# Talk to other Commonveil sites (docs/FEDERATION.md). false keeps this site to itself.
FEDERATION=true

# Which release to run. The updater changes this when you update.
COMMONVEIL_VERSION=latest
# This folder's full path, and a long random secret for the updater (install.sh makes one).
COMMONVEIL_DIR=/opt/commonveil
UPDATER_TOKEN=

# Only if this site can be reached under a path and nowhere else (rare): its protocol endpoints
# move under this prefix. Leave empty otherwise.
# FEDERATION_PATH_PREFIX=
